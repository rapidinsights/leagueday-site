---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'Book a demo',
  description: 'See LeagueDay with your own league schedule.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Book a demo" title="See your leagues in LeagueDay" />

  <!-- The form is not wired to a backend yet. Netlify Forms is the plan once the site is connected. -->
  <ContactUs
    id="form"
    subtitle="Tell us about your course and your leagues, and we will set up a walkthrough."
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' },
      { type: 'text', name: 'course', label: 'Course' },
    ]}
    textarea={{ label: 'How many leagues do you run, and how do you manage them today?' }}
    disclaimer={{ label: 'By submitting this form, you agree to be contacted about LeagueDay.' }}
  />
</Layout>
