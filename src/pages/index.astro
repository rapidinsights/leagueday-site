---
import Layout from '~/layouts/PageLayout.astro';

import HeroProduct from '~/components/widgets/HeroProduct.astro';
import TwoSides from '~/components/widgets/TwoSides.astro';
import StepsSticky from '~/components/widgets/StepsSticky.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

import heroTeeSheet from '~/assets/images/app/hero-tee-sheet.png';
import heroPhone from '~/assets/images/app/hero-phone.png';
import stepText from '~/assets/images/app/step-1-text.png';
import stepBook from '~/assets/images/app/step-2-book.png';
import stepLocked from '~/assets/images/app/step-3-locked.png';
import stepScores from '~/assets/images/app/step-4-scores.png';

// First-draft working copy drawn from the PRD. The copy pass replaces it.
const metadata = {
  title: 'LeagueDay | The easiest way to run your golf leagues',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <HeroProduct
    tagline="Golf league management for public courses"
    actions={[
      { variant: 'primary', text: 'Book a demo', href: '/contact' },
      { text: 'How it works', href: '#how-it-works' },
    ]}
    screenshots={{
      desktop: {
        src: heroTeeSheet,
        alt: "Staff tee sheet for Wednesday Twilight Men's, 65 of 72 slots booked",
      },
      phone: {
        src: heroPhone,
        alt: 'The same 4:40 PM tee time on a golfer’s phone, with cancellation closed',
      },
    }}
  >
    <Fragment slot="title">The easiest way to run your golf leagues</Fragment>
    <Fragment slot="subtitle">
      Golfers book their own tee times from a phone. Your staff sees every league on one sheet.
    </Fragment>
  </HeroProduct>

  <TwoSides
    title="The same tee sheet, from both sides"
    classes={{ container: 'pt-24 md:pt-40 lg:pt-40' }}
    left={{
      id: 'courses',
      title: 'For the pro shop',
      subtitle: 'For owners and staff running several leagues a week.',
      items: [
        {
          title: 'One tee sheet per league day',
          description: 'See every slot and who holds it. Book, move or cancel for a golfer who calls in.',
        },
        {
          title: 'Rosters that stay current',
          description: 'Add, move and archive golfers without rebuilding a sheet each season.',
        },
        {
          title: 'Deadlines that enforce themselves',
          description: 'Tee times open on schedule and late cancellations are blocked automatically.',
        },
        {
          title: 'No-shows and scores on record',
          description: 'Who showed up and what they shot, with a history your staff can look back on.',
        },
      ],
    }}
    right={{
      id: 'golfers',
      title: 'For golfers',
      subtitle: 'Made for league golfers in their 70s and 80s.',
      items: [
        { title: 'Three taps to book', description: 'Open the link from the text, tap an open slot, tap Book.' },
        { title: 'Large text, big buttons', description: 'Readable without glasses, on a phone or an iPad.' },
        { title: 'Nothing to install', description: 'No app to download and no password to remember.' },
        { title: 'See who is playing', description: 'The sheet updates live, so everyone sees the same open slots.' },
      ],
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white/60 border-t border-border"></div>
    </Fragment>
  </TwoSides>

  <StepsSticky
    id="how-it-works"
    title="A league day with LeagueDay"
    items={[
      {
        title: 'Tee times open two weeks out',
        description: 'Each league date publishes on schedule. Golfers get a link by text.',
        screenshot: { src: stepText, alt: 'Text messages from the course with an invite link and a tee time reminder' },
      },
      {
        title: 'Golfers book their own slots',
        description: 'They pick an open time and book it. Staff can book for anyone who calls in.',
        screenshot: { src: stepBook, alt: 'Golfer picking an open 7:40 AM tee time with a Book button' },
      },
      {
        title: 'The sheet locks before play',
        description: 'The cancellation deadline keeps the tee sheet stable in the final days.',
        screenshot: {
          src: stepLocked,
          alt: 'Golfer tee sheet showing the deadline has passed, with the pro shop number to call',
        },
      },
      {
        title: 'Play, then post scores',
        description: 'Scores and attendance go on record for the season.',
        screenshot: {
          src: stepScores,
          alt: 'Leaderboard of scores, averages and handicaps for Monday Afternoon Ladies',
        },
      },
    ]}
  />

  <CallToAction layout="banner" actions={[{ variant: 'primary', text: 'Book a demo', href: '/contact' }]}>
    <Fragment slot="title">See your leagues in LeagueDay</Fragment>
    <Fragment slot="subtitle">A short walkthrough using your own league schedule.</Fragment>
  </CallToAction>
</Layout>
