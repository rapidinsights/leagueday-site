---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

// First-draft working copy drawn from the PRD. The copy pass replaces it.
const metadata = {
  title: 'LeagueDay | Golf league management for public courses',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    tagline="Golf league management for public courses"
    actions={[
      { variant: 'primary', text: 'Book a demo', href: '/contact' },
      { text: 'How it works', href: '#how-it-works' },
    ]}
  >
    <Fragment slot="title">Every league tee sheet, full and on time.</Fragment>

    <Fragment slot="subtitle">
      LeagueDay replaces the league sign-up spreadsheet. Golfers book their own tee times from a phone, your staff sees
      every league at a glance, and no-shows get caught before the tee instead of at it.
    </Fragment>
  </Hero>

  <Features
    id="courses"
    tagline="For courses"
    title="Run every league from one place"
    subtitle="Built for course owners and pro shop staff who run several leagues a week."
    columns={2}
    items={[
      {
        title: 'One tee sheet per league day',
        description:
          'See every slot, who holds it and what is still open. Book, move or cancel for a golfer who calls the pro shop.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Rosters that stay current',
        description: 'Add, move and archive golfers across leagues without rebuilding a sheet each season.',
        icon: 'tabler:users',
      },
      {
        title: 'Deadlines that enforce themselves',
        description:
          'Tee times open on a set schedule and late cancellations are blocked automatically, so the sheet stays stable.',
        icon: 'tabler:clock-check',
      },
      {
        title: 'No-shows and scores on record',
        description: 'Track who showed up and what they shot, with a history your staff can look back on.',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white"></div>
    </Fragment>
  </Features>

  <Features
    id="golfers"
    tagline="For golfers"
    title="Booking a tee time takes three taps"
    subtitle="Made for league golfers in their 70s and 80s. Nothing to install and no password to remember."
    columns={3}
    items={[
      {
        title: 'Large text, big buttons',
        description: 'Readable without glasses and easy to tap, on a phone or an iPad.',
        icon: 'tabler:text-size',
      },
      {
        title: 'Remembers who you are',
        description: 'Your league and name are saved after the first booking. After that it is tap the slot, tap Book.',
        icon: 'tabler:user-check',
      },
      {
        title: 'See who is playing',
        description: 'The sheet updates live, so everyone sees the same open slots at the same time.',
        icon: 'tabler:eye',
      },
    ]}
  />

  <Steps
    id="how-it-works"
    tagline="How it works"
    title="A league day with LeagueDay"
    items={[
      {
        title: 'Tee times open two weeks out',
        description: 'Each league date publishes on schedule. Golfers get a link by text.',
        icon: 'tabler:calendar-plus',
      },
      {
        title: 'Golfers book their own slots',
        description: 'They pick an open time and book it. Staff can book for anyone who calls in.',
        icon: 'tabler:hand-finger',
      },
      {
        title: 'The sheet locks before play',
        description: 'The cancellation deadline keeps the tee sheet stable in the final days.',
        icon: 'tabler:lock',
      },
      {
        title: 'Play, then post scores',
        description: 'Scores and attendance go on record for the season.',
        icon: 'tabler:golf',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white"></div>
    </Fragment>
  </Steps>

  <CallToAction actions={[{ variant: 'primary', text: 'Book a demo', href: '/contact' }]}>
    <Fragment slot="title">See your leagues in LeagueDay</Fragment>
    <Fragment slot="subtitle">A short walkthrough using your own league schedule.</Fragment>
  </CallToAction>
</Layout>
