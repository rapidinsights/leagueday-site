---
import Headline from '~/components/ui/Headline.astro';
import ScreenshotSlot from '~/components/ui/ScreenshotSlot.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { StepsSticky as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-none text-left md:mx-0 md:mb-10',
      title: 'text-3xl md:text-[2.5rem]',
      ...((classes?.headline as Record<string, string>) ?? {}),
    }}
  />

  <aw-steps-sticky class="grid gap-16 md:grid-cols-12">
    <ol class="list-none md:col-span-5">
      {
        items.map((item, i) => (
          <li
            data-step
            {...(i === 0 ? { 'data-active': '' } : {})}
            class="group border-l-[3px] border-border py-6 pl-5 data-[active]:border-primary motion-safe:transition-colors"
          >
            <h3 class="font-heading text-xl font-semibold text-heading group-data-[active]:text-primary">
              {item.title}
            </h3>
            <p class="mt-2 leading-relaxed text-muted">{item.description}</p>
            <ScreenshotSlot label={item.screenshot} class="mt-5 aspect-[4/3] md:hidden" />
          </li>
        ))
      }
    </ol>
    <div class="hidden md:block md:col-span-7">
      <div class="sticky top-24 aspect-[4/3]">
        {
          items.map((item, i) => (
            <div
              data-shot
              {...(i === 0 ? { 'data-active': '' } : {})}
              class="absolute inset-0 opacity-0 data-[active]:opacity-100 motion-safe:transition-opacity motion-safe:duration-300"
            >
              <ScreenshotSlot label={item.screenshot} size="Real screenshot, 1600 x 1200" class="h-full" />
            </div>
          ))
        }
      </div>
    </div>
  </aw-steps-sticky>
</WidgetWrapper>

<script>
  class AwStepsSticky extends HTMLElement {
    observer?: IntersectionObserver;
    connectedCallback() {
      const steps = [...this.querySelectorAll<HTMLElement>('[data-step]')];
      const shots = [...this.querySelectorAll<HTMLElement>('[data-shot]')];
      const select = (index: number) => {
        [steps, shots].forEach((list) => list.forEach((el, i) => el.toggleAttribute('data-active', i === index)));
      };
      // A step becomes active when it crosses the middle band of the viewport.
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) select(steps.indexOf(entry.target as HTMLElement));
          });
        },
        { rootMargin: '-45% 0px -45% 0px' }
      );
      steps.forEach((step) => this.observer?.observe(step));
    }
    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }
  if (!customElements.get('aw-steps-sticky')) customElements.define('aw-steps-sticky', AwStepsSticky);
</script>
