---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-schibsted`.
// Colors are copied from the LeagueDay app's design system (Linen · Stone · Bottle),
// whose source of truth is web/app/globals.css in the leagueday repo. Keep in step.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-schibsted);
    --aw-font-serif: var(--font-schibsted);
    --aw-font-heading: var(--font-schibsted);

    --aw-color-primary: #14532d;
    --aw-color-secondary: #0a3a1d;
    --aw-color-accent: #7d5a0e;

    --aw-color-text-heading: #141a17;
    --aw-color-text-default: #141a17;
    --aw-color-text-muted: #4b524e;
    --aw-color-bg-page: #f2f2f0;

    --aw-color-bg-page-dark: #071c11;

    ::selection {
      background-color: #dcebe1;
    }
  }
</style>
