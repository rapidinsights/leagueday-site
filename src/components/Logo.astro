---
import { SITE } from 'astrowind:config';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 flex items-center gap-2 whitespace-nowrap">
  <svg aria-hidden="true" class="h-8 w-8 shrink-0" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
    <rect width="512" height="512" rx="96" fill="#14532d"></rect>
    <text
      x="256"
      y="270"
      font-family="system-ui, sans-serif"
      font-weight="700"
      font-size="220"
      fill="#ffffff"
      text-anchor="middle"
      dominant-baseline="central">LD</text
    >
  </svg>
  <span class="text-2xl md:text-xl font-bold text-heading">{SITE?.name}</span>
</span>
